#!/usr/bin/env bash
# Provider-neutral apple/container launcher for the LockBox sandbox.
#
# Native `container build/run/exec` flow — Docker-free successor to the Compose
# launcher. Same hardened image, egress
# lock, mounts, lifecycle, credential forwarding.
#
#   1. Prepare the selected provider's private config storage.
#   2. container build (cached) + idempotent run (reuse running / start stopped).
#   3. Replay lifecycle as `dev`: post-create once (sentinel), post-start always.
#   4. Authenticate at exec time without baking credentials into the image.
#   5. Claude imports curated config once, with an explicit refresh option.
#      LOCKBOX_REBUILD=1
#      forces an image/container refresh for either provider.
#
# apple/container deltas: `--init` = compose init:true; `--tmpfs` bare path only
# (no noexec/size — VM boundary covers it); no `--security-opt` (setuid stripped
# in image); provider config uses NATIVE named volumes (root can fix ownership).
set -euo pipefail

AGENT="${LOCKBOX_AGENT:-}"
case "$AGENT" in
  claude|codex) ;;
  "") echo "lockbox: no agent selected; use .devcontainer/bin/claude or .devcontainer/bin/codex" >&2; exit 2 ;;
  *) echo "lockbox: unsupported agent '$AGENT'" >&2; exit 2 ;;
esac
echo "lockbox: selected provider '$AGENT'." >&2

find_project_root() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/.devcontainer/Dockerfile" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
if [[ -n "${LOCKBOX_PROJECT_ROOT:-}" && -d "${LOCKBOX_PROJECT_ROOT}/.devcontainer" ]]; then
  PROJECT_ROOT="$LOCKBOX_PROJECT_ROOT"
else
  PROJECT_ROOT="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P || true)"
  [[ -d "$PROJECT_ROOT/.devcontainer" ]] || PROJECT_ROOT="$(find_project_root || true)"
fi
[[ -z "$PROJECT_ROOT" || ! -d "$PROJECT_ROOT/.devcontainer" ]] && {
  echo "$AGENT (lockbox): cannot locate the LockBox project root." >&2; exit 1; }
PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)"
DC="$PROJECT_ROOT/.devcontainer"

command -v container >/dev/null 2>&1 || { echo "$AGENT (lockbox): apple/container not installed." >&2; exit 1; }
container system status >/dev/null 2>&1 || { echo "$AGENT (lockbox): container system not started — run: container system start" >&2; exit 1; }

if [[ "$AGENT" == claude ]]; then NAME=lockbox-dev; else NAME=lockbox-codex; fi
IMAGE=lockbox-dev:latest
SVC_USER=dev
LAUNCHER="$PROJECT_ROOT/.devcontainer/bin/$AGENT"

# --- 1) Load shared helpers and stage provider config when needed ------------
LIB="$DC/launcher-common.sh"
[[ -f "$LIB" ]] || { echo "$AGENT (lockbox): missing $LIB (run LockBox/sync.sh)." >&2; exit 1; }
# shellcheck source=/dev/null
source "$LIB"
# Used by the sourced provider configuration helper.
# shellcheck disable=SC2034
AGENT_CONFIG_TOOL="$DC/agent-config.py"
# shellcheck source=../agent-config-launcher.sh
source "$DC/agent-config-launcher.sh"
STAGE_DIR="$HOME/.claude-sandbox/stage/lockbox-$AGENT"
lockbox_require_staging_boundary "$PROJECT_ROOT" "$HOME/.claude-sandbox"
mkdir -p "$STAGE_DIR"
lockbox_acquire_startup_lock "$STAGE_DIR" "$0" "$@"
# Lock host-executed git paths (.git + relocated core.hooksPath, e.g. .githooks)
# :ro over the RW workspace — an in-container agent must not plant a hook the HOST
# git runs on commit/push. Populates GIT_RO_MOUNTS; see launcher-common.sh.
sandbox_git_ro_mounts "$PROJECT_ROOT" /workspaces/LockBox
sandbox_devcontainer_ro_mounts "$PROJECT_ROOT" /workspaces/LockBox
sandbox_ro_mount_policy_id
LAUNCH_POLICY="$RO_MOUNT_POLICY_ID:agent-config-v3"

# --- 2) Build (cached → fast) ------------------------------------------------
container build -t "$IMAGE" "$DC" >/dev/null
# Free the ~2GB build-shim RAM now the image is built; it auto-restarts on the next
# `container build`. Set SANDBOX_KEEP_BUILDER=1 to leave it up (rapid rebuilds).
[[ -n "${SANDBOX_KEEP_BUILDER:-}" ]] || container builder stop >/dev/null 2>&1 || true

AGENT_MOUNTS=(-v "lockbox-$AGENT:/home/dev/.$AGENT"
  -v "$STAGE_DIR:/home/dev/.agent-stage-root:ro")


# --- 3) Idempotent run: reuse running / start stopped / else create ----------
if [[ "${LOCKBOX_REBUILD:-0}" == 1 ]]; then
  container rm -f "$NAME" >/dev/null 2>&1 || true
fi
if container ls -q 2>/dev/null | grep -qx "$NAME"; then
  :
elif container ls -aq 2>/dev/null | grep -qx "$NAME"; then
  container start "$NAME" >/dev/null
else
  container run -d --name "$NAME" \
    --init \
    --cap-drop ALL \
    --cap-add NET_ADMIN --cap-add CHOWN --cap-add DAC_OVERRIDE \
    --cap-add FOWNER --cap-add SETUID --cap-add SETGID \
    -m 4g -c 4 \
    --tmpfs /tmp --tmpfs /var/tmp \
    -e DEVCONTAINER=true \
    -e SANDBOX_AGENT="$AGENT" \
    -e SANDBOX_LAUNCH_POLICY="$LAUNCH_POLICY" \
    -e DISABLE_TELEMETRY=1 \
    -e DISABLE_ERROR_REPORTING=1 \
    -e NODE_USE_ENV_PROXY=1 \
    -e HTTP_PROXY=http://127.0.0.1:3128 \
    -e HTTPS_PROXY=http://127.0.0.1:3128 \
    -e http_proxy=http://127.0.0.1:3128 \
    -e https_proxy=http://127.0.0.1:3128 \
    -e NO_PROXY=localhost,127.0.0.1,::1 \
    -e no_proxy=localhost,127.0.0.1,::1 \
    -v "$PROJECT_ROOT:/workspaces/LockBox" \
    ${GIT_RO_MOUNTS[@]+"${GIT_RO_MOUNTS[@]}"} \
    ${DEVCONTAINER_RO_MOUNTS[@]+"${DEVCONTAINER_RO_MOUNTS[@]}"} \
    ${AGENT_MOUNTS[@]+"${AGENT_MOUNTS[@]}"} \
    "$IMAGE" >/dev/null
fi
CID="$NAME"

# Install cleanup before provider, lifecycle, or integrity checks can abort.
sandbox_install_stop_trap "$CID" "${LOCKBOX_STOP_ON_EXIT:-1}"

# SANDBOX_AGENT is fixed when a container is created. Refuse to reuse a stale or
# manually-created container under the selected provider's name: otherwise the
# lifecycle and doctor can describe/check Claude while the launcher opens Codex
# (or vice versa). Provider config lives in named volumes, so rebuilding the
# container does not discard the selected provider's login/config cache.
CONTAINER_AGENT="$(container exec "$NAME" printenv SANDBOX_AGENT 2>/dev/null || true)"
if [[ "$CONTAINER_AGENT" != "$AGENT" ]]; then
  echo "$AGENT (lockbox): ABORT — container '$NAME' has stale provider state '${CONTAINER_AGENT:-unset}'." >&2
  echo "  Recreate it with: LOCKBOX_REBUILD=1 $PROJECT_ROOT/.devcontainer/bin/$AGENT" >&2
  exit 1
fi

CONTAINER_POLICY="$(container exec "$NAME" printenv SANDBOX_LAUNCH_POLICY 2>/dev/null || true)"
if [[ "$CONTAINER_POLICY" != "$LAUNCH_POLICY" ]]; then
  echo "launcher: stale read-only mount/configuration policy; recreate with: LOCKBOX_REBUILD=1 $LAUNCHER" >&2
  exit 1
fi
lockbox_require_managed_policy "$NAME"
lockbox_require_agent_layout "$NAME" "LOCKBOX_REBUILD=1 $LAUNCHER"

# Wait for the egress proxy (entrypoint applies firewall → squid).
lockbox_wait_proxy "$NAME"

# F14: the egress allowlist is baked into the image; on the reuse/start paths the
# running container can be enforcing a stale baked copy after a sync.sh change.
sandbox_warn_stale_allowlist "$NAME" "$DC/allowlist.txt" "LOCKBOX_REBUILD=1 $LAUNCHER"

# --- 4) Replay lifecycle as dev (post-create once, post-start every start) ----
container exec --user "$SVC_USER" "$NAME" bash -lc '
  set -e
  cd /workspaces/LockBox
  if [[ ! -f /home/dev/.postcreate-done ]]; then
    bash .devcontainer/post-create.sh && touch /home/dev/.postcreate-done
  fi
  bash .devcontainer/post-start.sh'

# Import only after entrypoint and lifecycle readiness, for either provider.
lockbox_prepare_agent_config "$NAME" "$STAGE_DIR" "${LOCKBOX_CONFIG_REFRESH:-${LOCKBOX_CLAUDE_CONFIG_REFRESH:-0}}"
# Safe Chain startup hooks belong only to dev processes, never root startup.
EXEC_ENV=(-e BASH_ENV=/home/dev/.safe-chain/scripts/init-posix.sh)
lockbox_forward_mcp_environment "$NAME"

# --- 6) Launch-integrity gate (mandatory; fail closed) -----------------------
# A missing checker is NOT a soft warning: the current Dockerfile always bakes
# lockbox-verify-pins, so its absence means a stale pre-pin image is running
# UNVERIFIED. Hard-abort and tell the operator to rebuild (matches bin/dev).
if ! sandbox_verify_pins_cached "$NAME" "$SVC_USER"     /usr/local/bin/lockbox-verify-pins /usr/local/share/lockbox/binary-pins.txt LOCKBOX_PINFILE lockbox; then
  echo "launcher: ABORT — binary fingerprint drift. Rebuild with: LOCKBOX_REBUILD=1 $LAUNCHER" >&2
  exit 1
fi

# --- 8) Authenticate Codex on first use, then open the selected agent ---------
TTY_FLAGS=(-i)
[[ -t 0 && -t 1 ]] && TTY_FLAGS+=(-t)
lockbox_release_startup_lock
lockbox_ensure_agent_login "$SVC_USER" "$NAME" "Re-run $LAUNCHER in a terminal for native login."
set +e
container exec --user "$SVC_USER" "${TTY_FLAGS[@]}" ${EXEC_ENV[@]+"${EXEC_ENV[@]}"} "$NAME" "$AGENT" "$@"
_rc=$?
set -e
exit "$_rc"
