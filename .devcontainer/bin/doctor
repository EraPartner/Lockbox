#!/usr/bin/env bash
# LockBox devcontainer readiness check. Run INSIDE the container:
#   bash .devcontainer/bin/doctor
# (or:  container exec lockbox-dev bash /workspaces/LockBox/.devcontainer/bin/doctor)
#
# Startup fails closed on firewall/proxy failure. This also checks live mounts,
# tool integrity and native login after startup.

pass() { printf '  \033[32mok\033[0m   %s\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m %s\n' "$1"; FAILED=1; }
FAILED=0
AGENT="${SANDBOX_AGENT:-}"
case "$AGENT" in
  claude|codex) ;;
  *) fail "selected provider is invalid or unset (SANDBOX_AGENT='${AGENT:-unset}')"; exit 1 ;;
esac

echo "LockBox devcontainer doctor"
echo "----------------------------"
pass "selected provider: $AGENT"

# Sandbox integrity: .devcontainer holds the HOST-side agent launchers and
# the sandbox definition (Dockerfile, launcher run args). If writable from inside,
# a compromised agent can rewrite them and escape to the host on the next launch.
# The launcher mounts it read-only, but that only applies on container CREATE — a
# stale container booted before the change leaves the door open. Prove it's live
# by trying to write, not by trusting the config.
DC_DIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P || echo /workspaces/LockBox/.devcontainer)"
_probe="$DC_DIR/.doctor-write-probe.$$"
if ( : > "$_probe" ) 2>/dev/null; then
  rm -f "$_probe" 2>/dev/null || true
  fail ".devcontainer WRITABLE from inside — host launcher/run args can be tampered; REBUILD: LOCKBOX_REBUILD=1 .devcontainer/bin/$AGENT"
else
  pass ".devcontainer is read-only (anti-tamper overlay active)"
fi

WS=/workspaces/LockBox
# Verify read-only mount flags, not merely permissions that can hide a bad mount.
protected=()
for rel in .git .devcontainer sandbox/.devcontainer; do
  [[ -e "$WS/$rel" || -L "$WS/$rel" ]] && protected+=("$WS/$rel")
done
if [[ -d "$WS/.git" ]]; then
  hooks="$(git -C "$WS" rev-parse --git-path hooks)" || exit 1
  case "$hooks" in /*) ;; *) hooks="$WS/$hooks" ;; esac
  case "$hooks" in "$WS"/*) protected+=("$hooks") ;; esac
fi
if /opt/python/bin/python3 - "${protected[@]}" <<'MOUNT_CHECK'
import os, re, sys
mounts = []
def decode(value):
    return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match[1], 8)), value)
for line in open('/proc/self/mountinfo'):
    fields = line.split()
    mounts.append((decode(fields[4]), set(fields[5].split(',')), int(fields[0])))
for value in sys.argv[1:]:
    path = os.path.normpath(value)
    candidates = [m for m in mounts if path == m[0] or path.startswith(m[0].rstrip('/') + '/')]
    selected = max(candidates, key=lambda m: (len(m[0]), m[2]))
    if 'ro' not in selected[1]:
        print('read-only mount missing: ' + path, file=sys.stderr)
        sys.exit(1)
MOUNT_CHECK
then pass "Git, hooks and launcher trees have read-only mounts";
else fail "anti-tamper mount verification failed; recreate the container"; fi

# Egress proxy listening?
if (exec 3<>/dev/tcp/127.0.0.1/3128) 2>/dev/null; then pass "egress proxy listening on 127.0.0.1:3128"
else fail "egress proxy NOT listening on 127.0.0.1:3128 (check 'container logs <id>')"; fi

# Allowed provider egress through the proxy?
if [[ "$AGENT" == codex ]]; then provider_host=api.openai.com; else provider_host=api.anthropic.com; fi
code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 12 "https://$provider_host/" 2>/dev/null || true)
[[ "$code" =~ ^[1-5][0-9][0-9]$ ]] && pass "egress via proxy reaches $provider_host (HTTP $code)" || fail "cannot reach $provider_host through the proxy"

# Direct egress should be blocked.
if curl -sS -o /dev/null --max-time 6 --noproxy '*' "https://$provider_host/" 2>/dev/null; then
  fail "DIRECT egress (bypassing proxy) succeeded — firewall not enforcing!"
else pass "direct egress (bypassing proxy) is blocked"; fi

# A non-allowlisted host THROUGH the proxy must be denied (catches an allowlist
# regression — e.g. a squid misconfig that allowed everything).
if curl -sS -o /dev/null --max-time 10 https://example.com/ 2>/dev/null; then
  fail "non-allowlisted host (example.com) was ALLOWED through the proxy — allowlist regression!"
else pass "non-allowlisted host denied by the proxy allowlist"; fi

# Strict integrity checker must succeed, including manifest/ownership checks.
if /usr/local/bin/lockbox-verify-pins --quiet; then pass "binary pins and root ownership verified";
else fail "mandatory binary pin verification failed"; fi

# Toolchain.
command -v node >/dev/null && pass "node $(node -v)" || fail "node missing"
command -v npm  >/dev/null && pass "npm $(npm -v)"  || fail "npm missing"
command -v claude >/dev/null && pass "installed CLI: claude $(claude --version 2>/dev/null | head -1)" || fail "claude missing"
if command -v codex >/dev/null; then pass "installed CLI: codex $(codex --version 2>/dev/null | head -1)"; else fail "codex missing"; fi
command -v bwrap >/dev/null && pass "bubblewrap present (Codex sandbox prerequisite)" || fail "bubblewrap missing"
command -v safe-chain >/dev/null && pass "safe-chain present (package installs are screened)" \
  || fail "safe-chain MISSING — npm/bun/pip installs are NOT supply-chain screened"
# LockBox-specific toolchain (shell infra).
command -v shellcheck >/dev/null && pass "shellcheck $(shellcheck --version 2>/dev/null | awk '/version:/{print $2}')" || fail "shellcheck missing"
command -v make >/dev/null && pass "make present" || fail "make missing"

# Native login lives in the selected provider's private volume.
if [[ "$AGENT" == codex ]]; then
  if codex login status >/dev/null 2>&1; then pass "Codex private login is valid"; else fail "Codex is logged out"; fi
elif claude auth status >/dev/null 2>&1; then
  pass "Claude private login is valid"
elif [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}${ANTHROPIC_API_KEY:-}" ]]; then
  pass "Claude explicit environment authentication is present"
else
  fail "Claude is logged out; use the provider launcher interactively"
fi

# gh token forwarded?
[[ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]] \
  && pass "no git push token in env (publication uses the separate git-agent — expected)" \
  || fail "GH_TOKEN/GITHUB_TOKEN present — a container must NOT hold a git push credential"

# Egress audit log readable by dev?
if [[ -r /var/log/squid/access.log ]]; then pass "egress audit log readable: /var/log/squid/access.log"
else echo "  note /var/log/squid/access.log not yet created or unreadable (appears after first request)"; fi

# Claude config is staged only for Claude sessions; Codex uses its private volume.
if [[ "$AGENT" == claude ]]; then
  [[ -f /home/dev/.claude/settings.json ]] && pass "Claude config seeded (settings.json present)" \
    || fail "Claude config not seeded — claude will show first-run onboarding"
else
  if [[ -d /home/dev/.codex ]]; then pass "Codex private config volume present"; else fail "Codex config directory missing"; fi
fi

# Host disk: the workspace is a bind mount onto the host filesystem, so a
# runaway write here fills the HOST disk (no quota). Warn when free space is low.
avail_kb=$(df -P /workspaces/LockBox 2>/dev/null | awk 'NR==2{print $4}')
if [[ -n "$avail_kb" ]]; then
  avail_gb=$(( avail_kb / 1024 / 1024 ))
  (( avail_gb < 5 )) && fail "low free space on the workspace/host filesystem (${avail_gb} GB) — risk of filling the host disk" \
                     || pass "workspace/host free space OK (${avail_gb} GB)"
fi

echo "----------------------------"
(( FAILED )) && { echo "Some checks FAILED."; exit 1; } || { echo "All checks passed."; exit 0; }
