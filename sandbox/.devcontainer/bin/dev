#!/usr/bin/env bash
# dev — route the CURRENT directory into the generic full-dev sandbox.
#
# Resolves the target (current git repo root, else $PWD), hashes its path so each
# target gets its own container + private home volumes, mounts it READ-WRITE, and
# opens Claude Code or Codex inside the hardened image. apple/container only.
#
#   dev-claude          # explicitly run Claude against $PWD's project
#   dev-codex           # explicitly run Codex against $PWD's project
#   DEV_SANDBOX_AGENT=codex dev --version  # forward args to selected agent
#   DEV_SANDBOX_PORTS="8787 3000" dev-codex  # publish ports for selected provider
#   DEV_SANDBOX_SHELL=1 dev-codex       # open a shell with Codex's container state
#   DEV_SANDBOX_REBUILD=1 dev-codex     # force image+container refresh
#
# Per-target egress overlay: if the target has .sandbox-allowlist.txt (or
# .devcontainer/allowlist.extra.txt), its hosts are added on top of the base.
set -euo pipefail

AGENT="${DEV_SANDBOX_AGENT:-claude}"
case "$AGENT" in
  claude|codex) ;;
  *) echo "dev: unsupported agent '$AGENT' (use claude or codex)" >&2; exit 2 ;;
esac
echo "dev: selected provider '$AGENT'." >&2

# --- 0) Resolve target dir (git repo root, else CWD) -------------------------
TARGET="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
[[ -z "$TARGET" ]] && TARGET="$PWD"
TARGET="$(cd "$TARGET" && pwd -P)"

# Refuse dangerously broad / sensitive mounts.
deny() { echo "dev: refusing to mount '$TARGET' — $1. cd into a project subdir." >&2; exit 1; }
[[ -z "$TARGET" || "$TARGET" == "/" ]] && deny "the filesystem root"
[[ "$TARGET" == "$HOME" ]]             && deny "your home directory"
if [[ "$TARGET" == "/Users" || "$TARGET" =~ ^/Users/[^/]+$ ]]; then
  deny "a home root (too broad)"
fi
case "$TARGET" in
  "$HOME"/.ssh|"$HOME"/.aws|"$HOME"/.gnupg|"$HOME"/.config|"$HOME"/.kube|"$HOME"/.docker|"$HOME"/Library|"$HOME"/Library/*)
    deny "a sensitive home subdirectory" ;;
esac

HOST_PWD="$(pwd -P)"
DC="$(cd "$(dirname "$0")/.." && pwd -P)"
LAUNCHER="$DC/bin/dev-$AGENT"

command -v container >/dev/null 2>&1 || { echo "dev: apple/container not installed." >&2; exit 1; }
container system status >/dev/null 2>&1 || { echo "dev: container system not started — run: container system start" >&2; exit 1; }

HASH="$(printf '%s' "$TARGET" | shasum 2>/dev/null | cut -c1-12 || echo target)"
if [[ "$AGENT" == claude ]]; then NAME="dev-sandbox-$HASH"; else NAME="dev-sandbox-codex-$HASH"; fi
IMAGE="dev-sandbox:latest"
STAGE_DIR="$HOME/.claude-sandbox/stage/$NAME"
# Serialize the full policy/configuration startup. The lock is released before
# login or the interactive session, so concurrent sessions remain possible.
# shellcheck source=../launcher-common.sh
source "$DC/launcher-common.sh"
# shellcheck disable=SC2034
AGENT_CONFIG_TOOL="$DC/../../.devcontainer/agent-config.py"
# shellcheck source=../../../.devcontainer/agent-config-launcher.sh
source "$DC/../../.devcontainer/agent-config-launcher.sh"
sandbox_require_host_node
lockbox_require_staging_boundary "$TARGET" "$HOME/.claude-sandbox"
mkdir -p "$STAGE_DIR"
lockbox_acquire_startup_lock "$STAGE_DIR" "$0" "$@"
CONFIG_STAGE_DIR="$STAGE_DIR/agent-input"
# Apple Container omits a directory source when child files from that same
# source are mounted elsewhere. Keep config and policy mount sources siblings.
[[ ! -L "$CONFIG_STAGE_DIR" ]] || { echo 'dev: refusing symlinked configuration staging.' >&2; exit 1; }
mkdir -p "$CONFIG_STAGE_DIR"

# --- 1) Effective egress allowlist = baked base + this target's overlay -------
# F2: the overlay is read from the TARGET repo — the SAME untrusted content this
# sandbox runs, in the RW workspace an in-container agent can write. Letting it
# silently widen egress next launch is a self-escalation hole. So: surface the
# overlay's effective hosts and require interactive confirmation before they take
# effect. FAIL CLOSED — on a non-interactive (headless/piped) launch we can't
# prompt, so the overlay is IGNORED and only the trusted base allowlist applies.
ALLOWLIST_OUT="$STAGE_DIR/allowlist.txt"
ALLOWLIST_DESIRED="$STAGE_DIR/allowlist.desired.txt"
APPLIED_OUT="$STAGE_DIR/allowlist.applied"
[[ ! -L "$ALLOWLIST_OUT" && ! -L "$ALLOWLIST_DESIRED" && ! -L "$APPLIED_OUT" ]] || {
  echo 'dev: refusing symlinked allowlist state.' >&2; exit 1;
}

overlay_files=()
for overlay in "$TARGET/.sandbox-allowlist.txt" "$TARGET/.devcontainer/allowlist.extra.txt"; do
  [[ -f "$overlay" ]] && overlay_files+=("$overlay")
done

USE_OVERLAY=1
if (( ${#overlay_files[@]} > 0 )); then
  overlay_hosts="$(cat "${overlay_files[@]}" 2>/dev/null | grep -vE '^[[:space:]]*#' | grep -vE '^[[:space:]]*$' | sort -u || true)"
  if [[ -n "$overlay_hosts" ]]; then
    echo "dev: this target ships an egress allowlist OVERLAY (read from the workspace —" >&2
    echo "     the same untrusted content this sandbox runs). It would ADD these hosts:" >&2
    while IFS= read -r host; do printf '       + %s\n' "$host" >&2; done <<< "$overlay_hosts"
    for f in "${overlay_files[@]}"; do echo "     (from ${f#"$TARGET"/})" >&2; done
    if [[ -t 0 && -t 1 ]]; then
      ans=""
      printf 'dev: allow these extra egress hosts for THIS launch? [y/N] ' >&2
      read -r ans || true
      [[ "$ans" == [yY] || "$ans" == [yY][eE][sS] ]] || { USE_OVERLAY=0; echo "dev: overlay declined — base allowlist only." >&2; }
    else
      USE_OVERLAY=0
      echo "dev: non-interactive launch — IGNORING the overlay (base allowlist only)." >&2
      echo "     Re-run in a terminal to approve, or vet it and move it out of the workspace." >&2
    fi
  fi
fi

{
  cat "$DC/allowlist.txt"
  if (( USE_OVERLAY )); then
    for overlay in ${overlay_files[@]+"${overlay_files[@]}"}; do
      echo "# ==== overlay: ${overlay#"$TARGET"/} ===="
      cat "$overlay"
    done
  fi
} > "$ALLOWLIST_DESIRED"

NEW_ALLOWLIST_SUM="$(shasum -a 256 "$ALLOWLIST_DESIRED" | cut -d' ' -f1)"

# --- 2) Inbound ports → -p flags + the firewall's inbound-ports file ----------
INBOUND_OUT="$STAGE_DIR/inbound-ports"
OLD_INBOUND=""
[[ -f "$INBOUND_OUT" ]] && OLD_INBOUND="$(cat "$INBOUND_OUT" 2>/dev/null || true)"
: > "$INBOUND_OUT"
PORT_FLAGS=()
if [[ -n "${DEV_SANDBOX_PORTS:-}" ]]; then
  for p in ${DEV_SANDBOX_PORTS//,/ }; do
    [[ "$p" =~ ^[0-9]+$ ]] || { echo "dev: ignoring non-numeric port '$p'" >&2; continue; }
    PORT_FLAGS+=(-p "127.0.0.1:$p:$p")
    echo "$p" >> "$INBOUND_OUT"
  done
fi
NEW_INBOUND="$(cat "$INBOUND_OUT" 2>/dev/null || true)"

# --- 3b) Lock host-executed git paths READ-ONLY (.git + relocated hooks) -------
# Bind .git — and the effective core.hooksPath dir when it relocates hooks OUTSIDE
# .git (e.g. .githooks) — :ro OVER the RW workspace so an in-container agent can
# edit the working tree but CANNOT rewrite history or plant a hook the HOST git
# would later execute OUTSIDE the sandbox (a VM→host escape on `git commit`). Local
# commit/push is git-agent's job, not this box's. See sandbox_git_ro_mounts.
sandbox_git_ro_mounts "$TARGET" /workspaces/project
sandbox_devcontainer_ro_mounts "$TARGET" /workspaces/project
sandbox_ro_mount_policy_id

# Resolve only exact reviewed host roots. Unknown projects retain monitor-only behavior.
CLAUDE_POLICY_PROJECT="$(node "$DC/claude-guard.mjs" --profile-for-root "$TARGET")"
CLAUDE_POLICY_ROOT=/workspaces/project
IMAGE="$IMAGE-$CLAUDE_POLICY_PROJECT"

# --- 4) Build (skip when the image already exists, unless rebuild requested) --
# F7: `container build` is cached but still spins up the builder VM on every launch
# (startup latency). Skip it when the image already exists AND no rebuild was asked
# for. A sync.sh change to baked files requires DEV_SANDBOX_REBUILD=1. The
# allowlist is mounted and applied only after the confirmed restart below;
# inbound port bindings and firewall ports still require container recreation.
if [[ "${DEV_SANDBOX_REBUILD:-0}" == 1 ]] || ! container image inspect "$IMAGE" >/dev/null 2>&1; then
  container build --build-arg "CLAUDE_POLICY_PROJECT=$CLAUDE_POLICY_PROJECT" -t "$IMAGE" "$DC" >/dev/null
  # Free the ~2GB build-shim RAM now the image is built; it auto-restarts on the
  # next build. Set SANDBOX_KEEP_BUILDER=1 to leave it up (rapid rebuilds).
  [[ -n "${SANDBOX_KEEP_BUILDER:-}" ]] || container builder stop >/dev/null 2>&1 || true
fi

sandbox_image_policy_id "$IMAGE"
LAUNCH_POLICY="$RO_MOUNT_POLICY_ID:$IMAGE_POLICY_ID:agent-config-v3:input-v1"

# --- 5) Idempotent run: reuse running / start stopped / else create ----------
echo "dev: target $TARGET  (container $NAME)" >&2
# Host preflight and creation metadata checks precede cleanup ownership.
# Cleanup is armed before any startup transition or container lifecycle work.
CID="$NAME"
if [[ "${DEV_SANDBOX_REBUILD:-0}" == 1 ]]; then
  rm -f "$APPLIED_OUT"
  container rm -f "$NAME" >/dev/null 2>&1 || true
fi
PORTS_CHANGED_MSG="dev: WARN: DEV_SANDBOX_PORTS changed, but the -p bindings and the firewall's
     inbound-ports are fixed at CREATE — rebuild to apply: DEV_SANDBOX_REBUILD=1 $LAUNCHER"
POLICY_CONFIRMED=0
RUNNING_NAMES="$(container ls -q)" || { echo 'dev: cannot inspect running containers; refusing policy change.' >&2; exit 1; }
ALL_NAMES="$(container ls -aq)" || { echo 'dev: cannot inspect existing containers; refusing policy change.' >&2; exit 1; }
if grep -qx "$NAME" <<< "$ALL_NAMES"; then
sandbox_require_container_policy "$NAME" "$AGENT" "$LAUNCH_POLICY" || {
  echo "launcher: recreate with DEV_SANDBOX_REBUILD=1 $0" >&2; exit 1;
}
fi
sandbox_install_stop_trap "$CID" "${DEV_SANDBOX_STOP_ON_EXIT:-1}"
if grep -qx "$NAME" <<< "$RUNNING_NAMES"; then
  GENERATION="$(lockbox_container_generation "$NAME")" || {
    echo 'dev: cannot identify the running container boot; refusing policy reuse.' >&2; exit 1;
  }
  EXPECTED_APPLIED="lockbox-allowlist-v1 $GENERATION $NEW_ALLOWLIST_SUM"
  if [[ -f "$APPLIED_OUT" && "$(cat "$APPLIED_OUT")" == "$EXPECTED_APPLIED" ]] \
      && cmp -s "$ALLOWLIST_OUT" "$ALLOWLIST_DESIRED"; then
    POLICY_CONFIRMED=1
  else
    # A successful HUP only acknowledges signal delivery. It cannot prove that
    # Squid parsed and applied a narrowing. Restart before changing mounted
    # bytes, then confirm this fresh boot after the readiness barrier below.
    rm -f "$APPLIED_OUT"
    echo 'dev: egress policy is changed or unconfirmed — restarting the container.' >&2
    container stop "$NAME" >/dev/null || {
      echo 'dev: container stop failed; the mounted allowlist was not changed.' >&2; exit 1;
    }
    AFTER_STOP_NAMES="$(container ls -q)" || { echo 'dev: cannot verify the container stopped; refusing policy change.' >&2; exit 1; }
    if grep -qx "$NAME" <<< "$AFTER_STOP_NAMES"; then
      echo 'dev: container is still running after stop; refusing policy change.' >&2; exit 1
    fi
    # Preserve the bind-mounted file inode. Atomic replacement would leave an
    # existing single-file mount attached to the retired inode on restart.
    cat "$ALLOWLIST_DESIRED" > "$ALLOWLIST_OUT"
    container start "$NAME" >/dev/null
  fi
  [[ "$OLD_INBOUND" != "$NEW_INBOUND" ]] && echo "$PORTS_CHANGED_MSG" >&2
elif grep -qx "$NAME" <<< "$ALL_NAMES"; then
  rm -f "$APPLIED_OUT"
  cat "$ALLOWLIST_DESIRED" > "$ALLOWLIST_OUT"
  container start "$NAME" >/dev/null
  [[ "$OLD_INBOUND" != "$NEW_INBOUND" ]] && echo "$PORTS_CHANGED_MSG" >&2
else
  rm -f "$APPLIED_OUT"
  cat "$ALLOWLIST_DESIRED" > "$ALLOWLIST_OUT"
  AGENT_MOUNTS=(-v "dev-sandbox-$AGENT-$HASH:/home/dev/.$AGENT"
    -v "$CONFIG_STAGE_DIR:/home/dev/.agent-stage-root:ro")
  GIT_HOST_MOUNTS=()
  [[ ! -f "$HOME/.gitconfig" ]] || GIT_HOST_MOUNTS=(-v "$HOME/.gitconfig:/home/dev/.gitconfig-host:ro")
  container run -d --name "$NAME" \
    --init \
    --cap-drop ALL \
    --cap-add NET_ADMIN --cap-add CHOWN --cap-add DAC_OVERRIDE \
    --cap-add FOWNER --cap-add SETUID --cap-add SETGID \
    -m 6g -c 4 \
    --tmpfs /tmp --tmpfs /var/tmp \
    ${PORT_FLAGS[@]+"${PORT_FLAGS[@]}"} \
    -e DEVCONTAINER=true \
    -e DEV_SANDBOX=true \
    -e SANDBOX_AGENT="$AGENT" \
    -e SANDBOX_LAUNCH_POLICY="$LAUNCH_POLICY" \
    -e DISABLE_TELEMETRY=1 \
    -e DISABLE_ERROR_REPORTING=1 \
    -e NODE_USE_ENV_PROXY=1 \
    -e HTTP_PROXY=http://127.0.0.1:3128 \
    -e HTTPS_PROXY=http://127.0.0.1:3128 \
    -e http_proxy=http://127.0.0.1:3128 \
    -e https_proxy=http://127.0.0.1:3128 \
    -e NO_PROXY=localhost,127.0.0.1,::1 \
    -e no_proxy=localhost,127.0.0.1,::1 \
    -v "$TARGET:/workspaces/project" \
    ${GIT_RO_MOUNTS[@]+"${GIT_RO_MOUNTS[@]}"} \
    ${DEVCONTAINER_RO_MOUNTS[@]+"${DEVCONTAINER_RO_MOUNTS[@]}"} \
    -v "dev-sandbox-config-$HASH:/home/dev/.config" \
    -v "dev-sandbox-local-$HASH:/home/dev/.local" \
    ${AGENT_MOUNTS[@]+"${AGENT_MOUNTS[@]}"} \
    ${GIT_HOST_MOUNTS[@]+"${GIT_HOST_MOUNTS[@]}"} \
    -v "$ALLOWLIST_OUT:/etc/squid/allowlist.txt:ro" \
    -v "$INBOUND_OUT:/etc/egress/inbound-ports:ro" \
    "$IMAGE" >/dev/null
fi
# SANDBOX_AGENT is fixed at container creation. Detect stale/manual containers
# before lifecycle hooks use the wrong provider configuration or diagnostics.
# The cleanup trap is already installed so this abort cannot orphan the VM.
sandbox_require_container_policy "$NAME" "$AGENT" "$LAUNCH_POLICY" || {
  echo "launcher: recreate with DEV_SANDBOX_REBUILD=1 $0" >&2; exit 1;
}
# --- 8) Launch-integrity gate (cached for this running container boot) --------
# The canonical helper accepts only an exact root-owned cache record bound to
# the boot, verifier, manifest, service identity, and protocol. On a miss it
# invokes the absolute baked checker with startup hooks and pinfile overrides
# cleared, then atomically publishes the cache as root. A cold/stale image still
# fails closed because a missing checker or manifest can never produce a record.
if ! sandbox_verify_pins_cached "$NAME" dev \
    /usr/local/bin/dev-sandbox-verify-pins \
    /usr/local/share/dev-sandbox/binary-pins.txt \
    DEV_SANDBOX_PINFILE dev-sandbox; then
  echo "dev: ABORT — binary fingerprint drift in the sandbox (see above)." >&2
  echo "  If you intentionally upgraded a tool, rebuild to re-pin: DEV_SANDBOX_REBUILD=1 $LAUNCHER" >&2
  exit 1
fi

lockbox_require_managed_policy "$NAME" "$CLAUDE_POLICY_PROJECT" "$CLAUDE_POLICY_ROOT"
lockbox_require_agent_layout "$NAME" "DEV_SANDBOX_REBUILD=1 $LAUNCHER"

# --- 6) Confirm policy, then replay lifecycle as dev -------------------------
lockbox_wait_proxy "$NAME"
MOUNTED_ALLOWLIST_SUM="$(container exec --user dev -e BASH_ENV= "$NAME" sha256sum /etc/squid/allowlist.txt | cut -d' ' -f1)"
if [[ "$MOUNTED_ALLOWLIST_SUM" != "$NEW_ALLOWLIST_SUM" ]]; then
  rm -f "$APPLIED_OUT"
  echo 'dev: mounted allowlist differs from the desired policy; refusing launch.' >&2
  exit 1
fi
GENERATION="$(lockbox_container_generation "$NAME")"
if (( POLICY_CONFIRMED )) && [[ "$EXPECTED_APPLIED" != "lockbox-allowlist-v1 $GENERATION $NEW_ALLOWLIST_SUM" ]]; then
  rm -f "$APPLIED_OUT"
  echo 'dev: container restarted during policy validation; retry to confirm a fresh boot.' >&2
  exit 1
fi
APPLIED_TEMP="$(mktemp "$STAGE_DIR/.allowlist-applied.XXXXXX")"
printf 'lockbox-allowlist-v1 %s %s\n' "$GENERATION" "$NEW_ALLOWLIST_SUM" > "$APPLIED_TEMP"
mv -f "$APPLIED_TEMP" "$APPLIED_OUT"

container exec --user dev "$NAME" bash -lc '
  set -e
  if [[ ! -f /home/dev/.postcreate-done ]]; then
    bash /usr/local/share/dev-sandbox/post-create.sh
    touch /home/dev/.postcreate-done
  fi
  bash /usr/local/share/dev-sandbox/post-start.sh'

lockbox_prepare_agent_config "$NAME" "$CONFIG_STAGE_DIR" "${DEV_SANDBOX_CONFIG_REFRESH:-${DEV_SANDBOX_CLAUDE_CONFIG_REFRESH:-0}}"
# Safe Chain startup hooks belong only to dev processes, never root startup.
EXEC_ENV=(-e BASH_ENV=/home/dev/.safe-chain/scripts/init-posix.sh)
lockbox_forward_mcp_environment "$NAME"

# --- 9) Resolve the in-container working dir from the host PWD ----------------
CONTAINER_CWD="/workspaces/project"
rel="${HOST_PWD#"$TARGET"}"
[[ "$rel" != "$HOST_PWD" && -n "$rel" ]] && CONTAINER_CWD="/workspaces/project/${rel#/}"

# --- 10) Authenticate Codex on first use, then open the selected agent --------
# The cleanup trap was installed at step 5 after host policy validation and
# before startup, so later failures cannot orphan the selected VM.
if [[ -n "${DEV_SANDBOX_SHELL:-}" ]]; then
  set -- bash
else
  set -- "$AGENT" "$@"
fi
TTY_FLAGS=(-i)
[[ -t 0 && -t 1 ]] && TTY_FLAGS+=(-t)
lockbox_release_startup_lock
if [[ -z "${DEV_SANDBOX_SHELL:-}" ]]; then
  lockbox_ensure_agent_login dev "$NAME" "Re-run $LAUNCHER in a terminal for native login."
fi
set +e
# F6: set the working dir with `container exec -w` (apple/container 1.0.0) instead
# of a DEV_CWD env + `bash -c cd` wrapper. CONTAINER_CWD is always under the
# /workspaces/project mount (derived from HOST_PWD under TARGET), so it exists.
container exec --user dev -w "$CONTAINER_CWD" \
  ${TTY_FLAGS[@]+"${TTY_FLAGS[@]}"} ${EXEC_ENV[@]+"${EXEC_ENV[@]}"} "$NAME" "$@"
_rc=$?
set -e
exit "$_rc"
